<Window x:Class="Moji.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Moji.App" Style="{StaticResource {x:Type Window}}" Title="墨记" Width="1480" Height="1010" MinWidth="1100" MinHeight="760" WindowStartupLocation="CenterScreen" Icon="Assets/icon.png">
  <Grid x:Name="Root" Background="{DynamicResource Bg}" ClipToBounds="True">
    <Grid x:Name="EditorWarmHost" Width="1024" Height="768" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4096,0,0,0" IsHitTestVisible="False"/>
    <Grid x:Name="Shell" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="22,30,22,0">
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="6,0,0,30"><Image Source="Assets/icon.png" Width="42" Height="42"/><TextBlock Text="墨记" FontSize="27" FontWeight="SemiBold" Margin="14,2,0,0"/></StackPanel>
            <Button Click="SearchClick" Background="Transparent" Foreground="{DynamicResource Sub}" Padding="12,12" Margin="0,0,0,24" HorizontalContentAlignment="Stretch"><DockPanel><local:NativeIcon Kind="Search" Width="22" Height="22" Foreground="{DynamicResource Sub}" Margin="0,0,10,0"/><TextBlock Text="搜索" FontSize="12"/></DockPanel></Button>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Border Background="{DynamicResource Soft}" CornerRadius="10" Padding="16,14" Margin="0,23,0,23"><DockPanel><local:NativeIcon Kind="Cloud" Width="20" Height="20" Foreground="{DynamicResource Accent}" Margin="0,0,12,0" VerticalAlignment="Top"/><StackPanel><Button x:Name="SyncButton" Content="连接 GitHub  ↗" Click="SyncClick" Padding="0,8,0,0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" FontSize="11" Foreground="{DynamicResource Sub}"/></StackPanel></DockPanel></Border>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,20"><DockPanel><Button DockPanel.Dock="Right" ToolTip="设置" Click="SettingsClick" Padding="6" BorderThickness="0" Background="Transparent"><local:NativeIcon Kind="Settings" Width="22" Height="22" Foreground="{DynamicResource Sub}"/></Button></DockPanel></Border>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Click="HomeClick"/>
            <Button x:Name="AllNav" Style="{StaticResource NavButton}" Click="AllClick"/>
            <Button x:Name="StarNav" Style="{StaticResource NavButton}" Click="StarClick"/>
            <DockPanel Margin="12,28,7,8"><Button DockPanel.Dock="Right" Content="+" ToolTip="新建记事本" Click="NewNotebookClick" Padding="5,0" BorderThickness="0" Background="Transparent" FontSize="18" Foreground="{DynamicResource Sub}"/><TextBlock Text="我的记事本" FontSize="11" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/></DockPanel>
            <Separator Margin="8,2,8,10"/>
            <StackPanel x:Name="BooksPanel"/>
            <TextBlock Text="管理" Foreground="{DynamicResource Sub}" FontSize="11" Margin="11,13,0,8"/>
            <Separator Margin="8,2,8,12"/>
            <Button Style="{StaticResource NavButton}" Click="ArchiveClick"><StackPanel Orientation="Horizontal"><local:NativeIcon Kind="Archive" Width="22" Height="22" Foreground="{DynamicResource Sub}" Margin="0,0,14,0"/><TextBlock Text="归档记录" FontSize="13"/></StackPanel></Button>
            <Button x:Name="TrashNav" Style="{StaticResource NavButton}" Click="TrashClick"/>
          </StackPanel></ScrollViewer>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="81"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="35,0"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,0,9,0"/><TextBlock x:Name="SaveText" Text="已保存" FontSize="11" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" Margin="0,0,23,0"/><Button ToolTip="导入文件" Click="ImportClick" Padding="8" Margin="0,0,13,0" Background="Transparent" BorderThickness="0"><local:NativeIcon Kind="External" Width="22" Height="22" Foreground="{DynamicResource Sub}"/></Button><Button x:Name="NewRecordButton" Visibility="Collapsed" Content="+  新建记录" Style="{StaticResource PrimaryButton}" Click="NewNoteClick" Padding="18,11" FontSize="13"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="我的工作台" FontSize="15" FontWeight="Medium"/></StackPanel></DockPanel></Border>
        <ContentControl x:Name="Body" Grid.Row="1"/>
      </Grid>
    </Grid>
    <ContentControl x:Name="AuthHost"/>
    <Border x:Name="ToastBorder" Visibility="Collapsed" Background="#354730" CornerRadius="8" Padding="20,12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,28" MaxWidth="780"><TextBlock x:Name="ToastText" Foreground="#F4F7EF" FontSize="12" TextWrapping="Wrap"/></Border>
  </Grid>
</Window>
