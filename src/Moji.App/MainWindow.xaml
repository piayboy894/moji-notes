<Window x:Class="Moji.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Moji.App" Style="{StaticResource {x:Type Window}}" Title="墨记" Width="1480" Height="1010" MinWidth="1100" MinHeight="760" WindowStartupLocation="CenterScreen" Icon="Assets/icon.png">
  <Grid x:Name="Root" Background="{DynamicResource Bg}">
    <Grid x:Name="Shell" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="22,30,22,0">
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="6,0,0,30"><Image Source="Assets/icon.png" Width="42" Height="42"/><TextBlock Text="墨记" FontSize="27" FontWeight="SemiBold" Margin="14,2,0,0"/><TextBlock Text="M O J I" FontSize="10" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
            <Button Click="SearchClick" Background="Transparent" Foreground="{DynamicResource Sub}" Padding="12,12" Margin="0,0,0,24" HorizontalContentAlignment="Stretch"><DockPanel><TextBlock DockPanel.Dock="Right" Text="Ctrl K" FontSize="10" VerticalAlignment="Center"/><local:NativeIcon Kind="Search" Width="17" Height="17" Foreground="{DynamicResource Sub}" Margin="0,0,10,0"/><TextBlock Text="搜索你的空间" FontSize="12"/></DockPanel></Button>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="管理" Foreground="{DynamicResource Sub}" FontSize="11" Margin="11,13,0,8"/>
            <Separator Margin="8,2,8,12"/>
            <Button Style="{StaticResource NavButton}" Click="ArchiveClick"><StackPanel Orientation="Horizontal"><local:NativeIcon Kind="Archive" Width="19" Height="19" Foreground="{DynamicResource Sub}" Margin="0,0,14,0"/><TextBlock Text="归档记录" FontSize="13"/></StackPanel></Button>
            <Button x:Name="TrashNav" Style="{StaticResource NavButton}" Click="TrashClick"/>
            <Border Background="{DynamicResource Soft}" CornerRadius="10" Padding="16,14" Margin="0,23,0,23"><DockPanel><local:NativeIcon Kind="Cloud" Width="20" Height="20" Foreground="{DynamicResource Accent}" Margin="0,0,12,0" VerticalAlignment="Top"/><StackPanel><TextBlock x:Name="CloudStatus" Text="本地私人空间" FontSize="12"/><Button x:Name="SyncButton" Content="连接 GitHub  ↗" Click="SyncClick" Padding="0,8,0,0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" FontSize="11" Foreground="{DynamicResource Sub}"/></StackPanel></DockPanel></Border>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,20"><DockPanel><Button DockPanel.Dock="Right" ToolTip="锁定空间 Ctrl+Shift+L" Click="LockClick" Padding="6" BorderThickness="0" Background="Transparent"><local:NativeIcon Kind="Lock" Width="17" Height="17" Foreground="{DynamicResource Sub}"/></Button><Button DockPanel.Dock="Right" ToolTip="偏好设置" Click="SettingsClick" Padding="6" BorderThickness="0" Background="Transparent"><local:NativeIcon Kind="Settings" Width="19" Height="19" Foreground="{DynamicResource Sub}"/></Button><local:NativeIcon Kind="User" Width="20" Height="20" Foreground="{DynamicResource Sub}" Margin="0,0,11,0"/><TextBlock x:Name="ProfileName" Text="我的私人空间" FontSize="12" VerticalAlignment="Center"/></DockPanel></Border>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Click="HomeClick"/>
            <Button x:Name="AllNav" Style="{StaticResource NavButton}" Click="AllClick"/>
            <Button x:Name="StarNav" Style="{StaticResource NavButton}" Click="StarClick"/>
            <DockPanel Margin="12,28,7,8"><Button DockPanel.Dock="Right" Content="+" ToolTip="新建记事本" Click="NewNotebookClick" Padding="5,0" BorderThickness="0" Background="Transparent" FontSize="18" Foreground="{DynamicResource Sub}"/><TextBlock Text="我的记事本" FontSize="11" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/></DockPanel>
            <Separator Margin="8,2,8,10"/>
            <StackPanel x:Name="BooksPanel"/>
            <Expander Header="标签" FontSize="11" Foreground="{DynamicResource Sub}" Margin="13,22,5,0" IsExpanded="False"><WrapPanel x:Name="TagsPanel" Margin="0,10,0,0"/></Expander>
          </StackPanel></ScrollViewer>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="81"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="35,0"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,0,9,0"/><TextBlock x:Name="SaveText" Text="已加密保存" FontSize="11" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" Margin="0,0,23,0"/><Button ToolTip="导入文件" Click="ImportClick" Padding="8" Margin="0,0,13,0" Background="Transparent" BorderThickness="0"><local:NativeIcon Kind="External" Width="18" Height="18" Foreground="{DynamicResource Sub}"/></Button><Button Content="+  新建记录" Style="{StaticResource PrimaryButton}" Click="NewNoteClick" Padding="18,11" FontSize="13"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="我的工作台" FontSize="15" FontWeight="Medium"/><TextBlock Text="│   个人工作空间" Foreground="{DynamicResource Sub}" FontSize="12" Margin="17,1,0,0"/></StackPanel></DockPanel></Border>
        <ContentControl x:Name="Body" Grid.Row="1"/>
      </Grid>
    </Grid>
    <ContentControl x:Name="AuthHost"/>
    <Border x:Name="ToastBorder" Visibility="Collapsed" Background="#354730" CornerRadius="8" Padding="20,12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,28" MaxWidth="780"><TextBlock x:Name="ToastText" Foreground="#F4F7EF" FontSize="12" TextWrapping="Wrap"/></Border>
  </Grid>
</Window>
