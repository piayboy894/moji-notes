<Window x:Class="Moji.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="墨记 · 你的私人文本空间" Width="1460" Height="970" MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen" Icon="Assets/icon.png">
  <Grid x:Name="Root">
    <Grid x:Name="Shell" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="17,27,17,0">
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="7,0,0,28"><Image Source="Assets/icon.png" Width="35" Height="35"/><TextBlock Text="墨记" FontSize="22" FontWeight="SemiBold" Margin="12,1,0,0"/><TextBlock Text="M O J I" FontSize="9" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" Margin="13,0,0,0"/></StackPanel>
            <Button Click="SearchClick" Background="{DynamicResource Soft}" Foreground="{DynamicResource Sub}" FontSize="11" Content="⌕   搜索你的空间                 Ctrl K" Padding="10,11" Margin="2,0,2,22"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Separator/>
            <Button Content="▤    归档记录" Style="{StaticResource NavButton}" Click="ArchiveClick"/>
            <Button x:Name="TrashNav" Content="⌫    回收站" Style="{StaticResource NavButton}" Click="TrashClick"/>
            <Border Background="{DynamicResource Soft}" CornerRadius="8" Padding="13" Margin="0,14,0,18"><StackPanel><TextBlock x:Name="CloudStatus" Text="☁   本地私人空间" FontSize="11"/><Button x:Name="SyncButton" Content="连接 GitHub     ↗" Click="SyncClick" Padding="5,8,5,0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" FontSize="10" Foreground="{DynamicResource Sub}"/></StackPanel></Border>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,16"><DockPanel><Button DockPanel.Dock="Right" Content="⚿" ToolTip="锁定空间 Ctrl+Shift+L" Click="LockClick" Padding="7,5" BorderThickness="0" Background="Transparent"/><Button DockPanel.Dock="Right" Content="⚙" ToolTip="偏好设置" Click="SettingsClick" Padding="7,5" BorderThickness="0" Background="Transparent"/><StackPanel><TextBlock x:Name="ProfileName" Text="我的私人空间" FontSize="11"/><TextBlock Text="PERSONAL WORKSPACE" Foreground="{DynamicResource Sub}" FontSize="7" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <Button x:Name="HomeNav" Content="▦    工作台" Style="{StaticResource NavButton}" Click="HomeClick"/>
            <Button x:Name="AllNav" Content="▧    全部记录" Style="{StaticResource NavButton}" Click="AllClick"/>
            <Button x:Name="StarNav" Content="☆    我的收藏" Style="{StaticResource NavButton}" Click="StarClick"/>
            <DockPanel Margin="12,25,4,10"><Button DockPanel.Dock="Right" Content="+" ToolTip="新建记事本" Click="NewNotebookClick" Padding="5,0" BorderThickness="0" Background="Transparent" FontSize="17" Foreground="{DynamicResource Sub}"/><TextBlock Text="我的记事本" FontSize="10" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/></DockPanel>
            <StackPanel x:Name="BooksPanel"/>
            <TextBlock Text="标签" FontSize="10" Foreground="{DynamicResource Sub}" Margin="12,26,0,13"/>
            <WrapPanel x:Name="TagsPanel" Margin="7,0"/>
          </StackPanel></ScrollViewer>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="73"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="30,0"><DockPanel LastChildFill="True"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock x:Name="SaveText" Text="●  已加密保存" FontSize="10" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Content="↥" ToolTip="导入文件" Click="ImportClick" Padding="9,7" Margin="0,0,10,0" Background="Transparent" BorderThickness="0"/><Button Content="+  新建记录" Style="{StaticResource PrimaryButton}" Click="NewNoteClick" Padding="15,9" FontSize="12"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="我的工作台" FontSize="13" FontWeight="Medium"/><TextBlock Text="│   个人工作空间" Foreground="{DynamicResource Sub}" FontSize="10" Margin="15,1,0,0"/></StackPanel></DockPanel></Border>
        <ContentControl x:Name="Body" Grid.Row="1"/>
      </Grid>
    </Grid>
    <ContentControl x:Name="AuthHost"/>
    <Border x:Name="ToastBorder" Visibility="Collapsed" Background="#354730" CornerRadius="8" Padding="20,12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,28" MaxWidth="780"><TextBlock x:Name="ToastText" Foreground="#F4F7EF" FontSize="12" TextWrapping="Wrap"/></Border>
  </Grid>
</Window>
