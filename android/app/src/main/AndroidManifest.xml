<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.hardware.fingerprint" android:required="false"/>
    <application android:theme="@style/Theme.Moji" android:label="墨记" android:icon="@drawable/moji_icon" android:roundIcon="@drawable/moji_icon" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false" android:resizeableActivity="true" android:enableOnBackInvokedCallback="true">
        <meta-data android:name="com.samsung.android.multiwindow.enable" android:value="true"/>
